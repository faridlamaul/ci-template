{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/faridlamaul/shipguard/main/schema/shipguard.schema.json",
  "title": "shipguard configuration (.shipguard.yaml)",
  "description": "An empty file (or a null document) means the built-in defaults.",
  "type": [
    "object",
    "null"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "enforce",
        "audit"
      ]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scanners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "sast": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "disable_rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "default_excludes": {
              "type": "boolean"
            }
          }
        },
        "sca": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "licenses": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "deny": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "iac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "per_scanner": {
          "description": "A positive duration in ms, s, m or h units, such as 15m or 1h30m.",
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$",
          "not": {
            "pattern": "^(0+(\\.0*)?(ms|s|m|h))+$"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fail_on": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secrets": {
              "$ref": "#/$defs/threshold"
            },
            "sast": {
              "$ref": "#/$defs/threshold"
            },
            "sca": {
              "$ref": "#/$defs/threshold"
            },
            "iac": {
              "$ref": "#/$defs/threshold"
            }
          },
          "minProperties": 1
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expires": {
            "description": "A YYYY-MM-DD date. The pattern cannot check month lengths or leap years (2026-02-30 matches it); the parser is authoritative and rejects impossible dates.",
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
          }
        },
        "required": [
          "id",
          "reason",
          "expires"
        ]
      }
    },
    "ci": {
      "description": "shipguard ci settings. Read from the PR head, not the base.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "enum": [
            "",
            "go",
            "golang",
            "node",
            "python",
            "ruby",
            "rust"
          ]
        },
        "version": {
          "type": "string"
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "per_step": {
              "description": "A positive duration in ms, s, m or h units, such as 30m or 1h30m.",
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$",
              "not": {
                "pattern": "^(0+(\\.0*)?(ms|s|m|h))+$"
              }
            }
          }
        },
        "steps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lint": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "run": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "junit": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "coverage": {
                  "type": "string"
                }
              },
              "if": {
                "required": [
                  "run",
                  "enabled"
                ],
                "properties": {
                  "run": {
                    "minLength": 1
                  },
                  "enabled": {
                    "const": false
                  }
                }
              },
              "then": false
            },
            "test": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "run": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "junit": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "coverage": {
                  "type": "string"
                }
              },
              "if": {
                "required": [
                  "run",
                  "enabled"
                ],
                "properties": {
                  "run": {
                    "minLength": 1
                  },
                  "enabled": {
                    "const": false
                  }
                }
              },
              "then": false
            },
            "build": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "run": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "junit": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "coverage": {
                  "type": "string"
                }
              },
              "if": {
                "required": [
                  "run",
                  "enabled"
                ],
                "properties": {
                  "run": {
                    "minLength": 1
                  },
                  "enabled": {
                    "const": false
                  }
                }
              },
              "then": false
            }
          }
        }
      }
    }
  },
  "$defs": {
    "threshold": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "any",
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "severity": {
              "type": "string",
              "enum": [
                "critical",
                "high",
                "medium",
                "low",
                "info"
              ]
            },
            "fix_available_only": {
              "type": "boolean"
            }
          },
          "required": [
            "severity"
          ]
        }
      ]
    }
  }
}
